# === Clinic Web Port on VPS (Accessible to Nginx Proxy Manager) ===
CLINIC_PORT=3080

# === MongoDB Credentials ===
MONGO_ROOT_USER=clinic_admin
MONGO_ROOT_PASSWORD=ChangeThisToAStrongSecretPassword2026!

# === Backend Security ===
JWT_SECRET=super_secret_production_jwt_key_random_alphanumeric_string_64_chars
PORT=5000
NODE_ENV=production

# === Initial Admin Seed Credentials ===
INITIAL_ADMIN_NAME=Clinic Administrator
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=AdminSecurePass2026!
